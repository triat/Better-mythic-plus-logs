      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:health | stats max(backupAgeS) age",
          "queryType": "statsRange",
          "editorMode": "code",
