# bmpl hosted mode — copy to .env on the server. The nine variables above the "Optional" line are required.
BMPL_MODE=hosted
# Public origin (scheme + host, no path) — used for OAuth redirects and origin checks.
BMPL_BASE_URL=https://bmpl.example.com
# ≥ 32 random bytes; generate with: openssl rand -base64 48 (no placeholders — the server refuses them)
BMPL_SESSION_SECRET=
# Discord application (https://discord.com/developers/applications) — OAuth2 tab.
BMPL_DISCORD_CLIENT_ID=
BMPL_DISCORD_CLIENT_SECRET=
# OAuth2 redirect URL to register in the Discord application: <BMPL_BASE_URL>/auth/discord/callback
# Comma-separated Discord user ids that are admins (auto-invited).
# Discord user ids are 17-20 digit numbers (Developer Mode -> Copy User ID).
BMPL_ADMIN_DISCORD_IDS=
# Battle.net application (https://community.developer.battle.net → API Access → Create New Client; two-factor
# authentication required). Redirect URL to register: <BMPL_BASE_URL>/auth/bnet/callback
BMPL_BNET_CLIENT_ID=
BMPL_BNET_CLIENT_SECRET=
# Shared Warcraft Logs API client (https://www.warcraftlogs.com/api/clients).
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
# Optional: WCL points each member may spend per hour (default 300; admins are exempt).
BMPL_POINTS_PER_USER_HOUR=300
# Optional: let any Discord account sign in (default false = invite-only). Admins can ban accounts.
BMPL_OPEN_SIGNUP=false
# Optional: require membership of this Discord server (Developer Mode -> Copy Server ID). Adds the "guilds" OAuth scope.
BMPL_DISCORD_GUILD_ID=
# Optional: lets members store their own Warcraft Logs client (secret encrypted at rest). 32 random bytes, base64:
#   openssl rand -base64 32
# Losing this key makes every stored client unusable (members simply save it again).
BMPL_ENCRYPTION_KEY=
# Optional: who runs this instance, shown on /privacy (default "the admin of this instance").
BMPL_OPERATOR=
# Optional: where members reach you, linked from the sidebar and the account menu. Unset: your Discord profile
# (https://discord.com/users/<the first BMPL_ADMIN_DISCORD_IDS>); "off": no link.
BMPL_CONTACT_URL=
# Optional: a "Support bmpl" link (e.g. https://buymeacoffee.com/<you>). Unset: no link.
BMPL_SUPPORT_URL=
# Optional, both or neither: the Umami instance that counts page views and a few events (deploy/README.md § 9e), its
# https origin and the website id Umami shows for this site. Unset: no tracker, nothing sent.
BMPL_ANALYTICS_URL=
BMPL_ANALYTICS_WEBSITE_ID=
# Optional: bearer token for the read-only /api/ops/* routes (errors and status for the operator's
# tooling); at least 32 bytes — `openssl rand -base64 48`. Unset: the routes do not exist; "off" also
# disables the bootstrap token of bmpl.riat.dev.
BMPL_OPS_TOKEN=
# Optional: the default region for lookups — eu (default), us, kr or tw.
BMPL_REGION=
# Optional: BMPL_DB_PATH, BMPL_EVAL_CONFIG, BMPL_DEFENSIVES (default: next to this file).
# Optional: the weekly recalibration (deploy/bmpl-calibrate-*.timer). BMPL_CALIBRATION_RESERVE: WCL points kept free
# for the members in every hour (default 3000); BMPL_CALIBRATION_DB: its database (default calibration.db, here).
# Deploy (used by 'just deploy' on your machine, not by the server): BMPL_DEPLOY_HOST=deploy@bmpl.example.com
