    {
      "id": 1,
      "title": "Server errors",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:server_error",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 10
      },
      "description": "Each line carries `req`, the X-Request-Id a member can report, and `user`; a 5xx answered without an exception (a failed lookup, season sync or deep-dive) carries `target` instead of a stack.",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 10,
      "title": "WCL errors",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:wcl_error",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "description": "One line per Warcraft Logs failure: kind, status, message, the member (`user`), what they were doing (`target`: lookup, season or deep-dive with its character or report) and the request id (`req`). Replaces the admin page's Errors chip.",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 12,
      "title": "Browser errors",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:client_error",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "description": "One line per uncaught error of the page (POST /api/client-error): message, stack, page (pathname only), version and member. At most five per page load.",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 2,
      "title": "4xx and 5xx per hour",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:http_request status:>=500 | stats count() 5xx",
          "queryType": "statsRange",
          "editorMode": "code",
          "legendFormat": "5xx"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:http_request status:>=400 status:<500 | stats count() 4xx",
          "queryType": "statsRange",
          "editorMode": "code",
          "legendFormat": "4xx"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "interval": "1h"
    },
    {
      "id": 3,
      "title": "WCL errors by kind",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:wcl_error | stats by (kind) count() errors",
          "queryType": "statsRange",
          "editorMode": "code",
          "legendFormat": "{{kind}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "interval": "1h"
    },
    {
      "id": 4,
      "title": "Slowest routes (p95, ms)",
      "type": "table",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:http_request | stats by (route) quantile(0.95, ms) p95_ms, count() requests | sort by (p95_ms desc) | limit 15",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 12,
        "h": 9
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "replace": true
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "route": 0,
              "p95_ms": 1,
              "requests": 2
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "p95_ms",
                "destinationType": "number"
              },
              {
                "targetField": "requests",
                "destinationType": "number"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Other warnings and errors",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl level:in(warn,error) -event:in(server_error,wcl_error,client_error,upstream,calibration_sample)",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 38,
        "w": 12,
        "h": 9
      },
      "description": "Battle.net, Discord, audit and usage write failures. Failed outbound calls are on Dependencies, failed recalibration lookups on Recalibration.",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 6,
      "title": "Lines that are not JSON (crashes, Bun's own output)",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl -event:*",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Releases and restarts",
        "enable": true,
        "iconColor": "blue",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:startup",
          "queryType": "instant",
          "editorMode": "code"
        }
      }
    ]
  }
}
