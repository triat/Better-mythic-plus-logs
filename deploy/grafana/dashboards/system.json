    {
      "id": 6,
      "title": "Memory (MB)",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:health | stats max(rss_mb) rss, max(heap_mb) heap",
          "queryType": "statsRange",
          "editorMode": "code",
          "legendFormat": "{{__name__}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "description": "rss: the whole process; heap: JavaScript objects.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true,
            "showPoints": "never"
          },
          "unit": "decmbytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "interval": "1h"
    },
    {
      "id": 7,
      "title": "Database size",
