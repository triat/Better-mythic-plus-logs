        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "interval": "1h"
    },
    {
      "id": 10,
      "title": "Shared WCL budget: points per hour",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:wcl_hour | stats sum(shared_points) members_shared, sum(own_points) members_own",
          "queryType": "statsRange",
          "editorMode": "code",
          "legendFormat": "{{__name__}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:wcl_hour | stats max(limit) limit",
          "queryType": "statsRange",
          "editorMode": "code",
          "legendFormat": "limit"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 16,
        "h": 9
      },
      "description": "members_shared: points charged to members on the shared client; members_own: their own clients (no shared budget). The recalibration's spend is on Recalibration.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.spanNulls",
                "value": true
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "interval": "1h"
    },
