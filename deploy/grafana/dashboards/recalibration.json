{
  "uid": "bmpl-recalibration",
  "title": "bmpl \u00b7 Recalibration",
  "description": "bmpl calibrate --hourly / --fit (spec 2026-10-14-weekly-recalibration-design.md): the 4-week window, each sample, the points it spends and the weekly fit.",
  "tags": [
    "bmpl"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5m",
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Releases and restarts",
        "enable": true,
        "iconColor": "blue",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:startup",
          "queryType": "instant",
          "editorMode": "code"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Window",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
