{
  "uid": "bmpl-recalibration",
  "title": "bmpl \u00b7 Recalibration",
  "description": "bmpl calibrate --hourly / --fit (spec 2026-10-14-weekly-recalibration-design.md).",
  "tags": [
    "bmpl"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5m",
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Characters sampled per hour",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "event:calibration_hour | stats sum(looked) sampled, sum(failed) failed",
          "queryType": "statsRange",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "interval": "1h"
    },
    {
      "id": 2,
      "title": "Characters in the 4-week window (target 2,000)",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "event:calibration_hour | stats max(window) window",
          "queryType": "statsRange",
          "editorMode": "code",
          "legendFormat": "window"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "interval": "1h",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Why each hour stopped",
      "type": "table",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "event:calibration_hour | stats by (stopped) count() hours | sort by (hours desc)",
          "queryType": "stats",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 4,
      "title": "Weekly fits",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "event:calibration_fit",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 5,
      "title": "Failures and notes",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "event:in(calibration_failed,calibration_note)",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
