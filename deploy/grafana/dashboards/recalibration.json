        "x": 0,
        "y": 20,
        "w": 8,
        "h": 10
      },
      "description": "The last 4 weeks: the collector fills the emptiest cell first.",
      "options": {
        "showHeader": true
      },
      "timeFrom": "28d",
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "replace": true
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "role": 0,
              "key_level": 1,
              "samples": 2
