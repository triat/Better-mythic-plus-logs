# bmpl hosted mode — copy to .env on the server. The seven variables above the "Optional" line are required.
BMPL_MODE=hosted
# Public origin (scheme + host, no path) — used for OAuth redirects and origin checks.
BMPL_BASE_URL=https://bmpl.example.com
# ≥ 32 random bytes; generate with: openssl rand -base64 48 (no placeholders — the server refuses them)
BMPL_SESSION_SECRET=
# Discord application (https://discord.com/developers/applications) — OAuth2 tab.
BMPL_DISCORD_CLIENT_ID=
BMPL_DISCORD_CLIENT_SECRET=
# OAuth2 redirect URL to register in the Discord application: <BMPL_BASE_URL>/auth/discord/callback
# Comma-separated Discord user ids that are admins (auto-invited).
# Discord user ids are 17-20 digit numbers (Developer Mode -> Copy User ID).
BMPL_ADMIN_DISCORD_IDS=
# Shared Warcraft Logs API client (https://www.warcraftlogs.com/api/clients).
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
# Optional: WCL points each member may spend per hour (default 300; admins are exempt).
BMPL_POINTS_PER_USER_HOUR=300
# Optional: let any Discord account sign in (default false = invite-only). Admins can ban accounts.
BMPL_OPEN_SIGNUP=false
# Optional: require membership of this Discord server (Developer Mode -> Copy Server ID). Adds the "guilds" OAuth scope.
BMPL_DISCORD_GUILD_ID=
# Optional: lets members store their own Warcraft Logs client (secret encrypted at rest). 32 random bytes, base64:
#   openssl rand -base64 32
# Losing this key makes every stored client unusable (members simply save it again).
BMPL_ENCRYPTION_KEY=
# Optional: who runs this instance, shown on /privacy (default "the admin of this instance").
BMPL_OPERATOR=
# Optional: BMPL_DB_PATH, BMPL_EVAL_CONFIG, BMPL_DEFENSIVES (default: next to this file).
# Deploy (used by 'just deploy' on your machine, not by the server): BMPL_DEPLOY_HOST=root@bmpl.example.com
