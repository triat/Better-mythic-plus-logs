{
  "uid": "bmpl-errors",
  "title": "bmpl \u00b7 Errors",
  "description": "Server errors with their stack and request id, WCL errors, error rates, slow routes.",
  "tags": [
    "bmpl"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Server errors",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:server_error",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "description": "Each line carries `req`, the X-Request-Id a member can report.",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 2,
      "title": "4xx and 5xx per hour",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:http_request status:>=500 | stats count() 5xx",
          "queryType": "statsRange",
          "editorMode": "code",
          "legendFormat": "5xx"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:http_request status:>=400 status:<500 | stats count() 4xx",
          "queryType": "statsRange",
          "editorMode": "code",
          "legendFormat": "4xx"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "interval": "1h"
    },
    {
      "id": 3,
      "title": "WCL errors by kind",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:wcl_error | stats by (kind) count() errors",
          "queryType": "statsRange",
          "editorMode": "code",
          "legendFormat": "{{kind}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "interval": "1h"
    },
    {
      "id": 4,
      "title": "Slowest routes (p95, ms)",
      "type": "table",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:http_request | stats by (route) quantile(0.95, ms) p95_ms, count() requests | sort by (p95_ms desc) | limit 15",
          "queryType": "stats",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 5,
      "title": "Other warnings and errors",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl level:in(warn,error) -event:in(server_error,wcl_error)",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "description": "Battle.net, Discord, audit and usage write failures.",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 6,
      "title": "Lines that are not JSON (crashes, Bun's own output)",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl -event:*",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
