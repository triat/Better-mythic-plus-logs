{
  "uid": "bmpl-security",
  "title": "bmpl \u00b7 Security",
  "description": "Refusals recorded by bmpl and what Caddy saw (client IPs are kept 90 days, see /privacy).",
  "tags": [
    "bmpl"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Refusals per day",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:audit kind:security | stats by (action) count() n",
          "queryType": "statsRange",
          "editorMode": "code",
          "legendFormat": "{{action}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "interval": "1d"
    },
    {
      "id": 2,
      "title": "Responses by status (Caddy)",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:caddy | stats by (status) count() n",
          "queryType": "statsRange",
          "editorMode": "code",
          "legendFormat": "{{status}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "interval": "1h"
    },
    {
      "id": 3,
      "title": "Top client IPs (Caddy)",
      "type": "table",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:caddy | stats by (request.client_ip) count() hits | sort by (hits desc) | limit 20",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 10
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "replace": true
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "request.client_ip": 0,
              "hits": 1
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "hits",
                "destinationType": "number"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Most requested paths that answered 404 (Caddy)",
      "type": "table",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:caddy status:404 | stats by (request.uri) count() hits | sort by (hits desc) | limit 20",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 10
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "replace": true
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "request.uri": 0,
              "hits": 1
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "hits",
                "destinationType": "number"
              }
            ]
          }
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Releases and restarts",
        "enable": true,
        "iconColor": "blue",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:startup",
          "queryType": "instant",
          "editorMode": "code"
        }
      }
    ]
  }
}
