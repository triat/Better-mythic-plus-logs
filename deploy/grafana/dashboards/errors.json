      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:in(server_error,wcl_error) user:* | stats count_uniq(user) members",
          "queryType": "stats",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "timeFrom": "24h",
      "description": "Distinct members whose request met a server or WCL error.",
      "fieldConfig": {
