    {
      "id": 9,
      "title": "Members and sessions",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:health | stats max(users) members, max(sessions) sessions",
          "queryType": "statsRange",
          "editorMode": "code",
          "legendFormat": "{{__name__}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true,
            "showPoints": "never"
          }
