    {
      "id": 16,
      "title": "Weekly fits: held-out characters, verdict changes and median score per role",
      "type": "table",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "service:bmpl event:calibration_fit | format \"<time:_time>\" as fitted | stats by (fitted) max(test) held_out, max(verdictChanges) changes, max(tank_fit) tank_n, max(tank_median_current) tank_now, max(tank_median_candidate) tank_new, max(healer_fit) healer_n, max(healer_median_current) healer_now, max(healer_median_candidate) healer_new, max(dps_fit) dps_n, max(dps_median_current) dps_now, max(dps_median_candidate) dps_new | sort by (fitted desc)",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 6
      },
      "description": "<role>_n: characters in the fit half; <role>_now / <role>_new: the role's median score today and with the candidate curves. The pull request opens when 2 % of the held-out characters change verdict or a median moves 2 points.",
      "options": {
        "showHeader": true
      },
      "timeFrom": "90d",
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "replace": true
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
